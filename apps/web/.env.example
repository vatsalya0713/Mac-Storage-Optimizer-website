# Copy to .env.local for local dev. On Vercel, set these in the web
# project's Environment Variables settings instead — never commit real
# values here.

# Supabase — same project as apps/admin, service role key (server-only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/success
# Product created once in the Dodo dashboard for "MacDiskCleaner Pro", $12.99 one-time.
DODO_PRODUCT_ID_PRO=

# Resend — for the license-key email sent after checkout.
RESEND_API_KEY=
