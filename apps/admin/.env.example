# Copy to .env.local for local dev. On Vercel, set these in the admin
# project's Environment Variables settings instead — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the entire admin panel (see proxy.ts) — this repo
# had NO authentication at all before this. Pick a strong, unique value.
ADMIN_PASSWORD=
